# Optional OpenAI-compatible multimodal qualitative reviewer.
# The deterministic benchmark still works when OPENAI_API_KEY is empty.
ARCHIC_AI_PROVIDER=openai
OPENAI_API_KEY=

# Provider endpoint. Root URLs are normalized to /v1 automatically.
# SynteroLink OpenAI/Codex example:
ARCHIC_OPENAI_BASE_URL=https://api.synterolink.com

# Cost/quality defaults. Use a model supported by the configured provider/key group.
ARCHIC_OPENAI_MODEL=gpt-5.6-terra
ARCHIC_OPENAI_IMAGE_DETAIL=high
ARCHIC_OPENAI_MAX_OUTPUT_TOKENS=3500

# Backwards-compatible model variable. ARCHIC_OPENAI_MODEL takes precedence.
ARCHIC_REVIEW_MODEL=

# Optional custom benchmark time zone.
ARCHIC_TIMEZONE=Europe/Madrid
