# AI reviewer. `auto` prefers Cursor and can fall back to OpenAI.
ARCHIC_AI_PROVIDER=auto
CURSOR_API_KEY=
ARCHIC_CURSOR_MODEL=composer-2.5

# Optional OpenAI fallback / backward compatibility.
OPENAI_API_KEY=
ARCHIC_OPENAI_MODEL=
ARCHIC_REVIEW_MODEL=

# Optional model for Cursor cloud autofix PRs.
ARCHIC_CURSOR_FIX_MODEL=composer-2.5

# Optional custom benchmark time zone.
ARCHIC_TIMEZONE=Europe/Madrid
